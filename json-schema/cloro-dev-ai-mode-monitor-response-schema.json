        "reviews": {
          "type": "integer",
          "description": "Number of reviews"
        },
        "type": {
          "type": "string",
          "description": "Place type or category"
        },
        "address": {
          "type": "string",
          "description": "Full postal address, as Google gives it on the card's Directions link"
        },
        "status": {
          "type": "string",
          "description": "Operating status"
        },
        "placeId": {
          "type": "string",
          "description": "Google Knowledge Graph ID for the place. A place and its `map` entry share it. Omitted when Google did not geo-tag the card."
        },
        "phone": {
          "type": "string",
          "description": "Phone number from the card's Call button, formatted as Google ships it for the locale. Omitted when the card has no Call button."
        },
        "website": {
          "type": "string",
          "format": "uri",
          "description": "Business website from the card's Website button. Omitted when the card has no Website button."
        }
      }
    },
    "ProductResult": {
      "type": "object",
      "description": "One product cluster and its merchant offers. Only `title` is guaranteed; anything Google's panel lacks is omitted, never sent as `null`.",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Product cluster title, as Google displayed it. Empty when the page has no product heading."
        },
